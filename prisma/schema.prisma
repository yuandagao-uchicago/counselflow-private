generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// ENUMS
// =============================================

enum StudentStatus {
  PROSPECT
  ACTIVE
  DEFERRED
  GRADUATED
  ARCHIVED
}

enum GradeLevel {
  FRESHMAN
  SOPHOMORE
  JUNIOR
  SENIOR
  GAP_YEAR
  TRANSFER
}

enum StudentPhase {
  EXPLORATION
  LIST_BUILDING
  TESTING
  APPLICATIONS
  ESSAYS
  SUBMISSIONS
  DECISIONS
  ENROLLMENT
}

enum ApplicationPlatform {
  COMMON_APP
  COALITION
  UC_APPLICATION
  APPLY_TEXAS
  SCHOOL_DIRECT
  OTHER
}

enum ApplicationType {
  EARLY_DECISION
  EARLY_DECISION_2
  EARLY_ACTION
  RESTRICTIVE_EARLY_ACTION
  REGULAR_DECISION
  ROLLING
}

enum ApplicationStatus {
  PLANNING
  IN_PROGRESS
  READY_FOR_REVIEW
  SUBMITTED
  WITHDRAWN
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  SKIPPED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  WAITING_ON_EXTERNAL
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskSource {
  MANUAL
  AI_EXTRACTED
  SYSTEM_GENERATED
}

enum DocumentType {
  QUESTIONNAIRE
  TRANSCRIPT
  TEST_SCORE
  RESUME
  ESSAY_DRAFT
  RECOMMENDATION_LETTER
  FINANCIAL_AID
  MEETING_NOTES
  COMMUNICATION
  OTHER
}

enum EssayStatus {
  BRAINSTORMING
  OUTLINE
  FIRST_DRAFT
  REVISION
  FINAL
  SUBMITTED
}

enum AIConfidence {
  HIGH
  MEDIUM
  LOW
}

enum AutonomyMode {
  SUGGEST
  DRAFT
  EXECUTE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  REVISED
}

enum CommunicationType {
  EMAIL
  TEXT
  PHONE_CALL
  IN_APP_NOTE
  PORTAL_MESSAGE
}

enum CommunicationDirection {
  OUTBOUND
  INBOUND
}

enum RecommenderType {
  TEACHER
  COUNSELOR
  EMPLOYER
  MENTOR
  PEER
  OTHER
}

enum RecommenderRequestStatus {
  NOT_REQUESTED
  REQUESTED
  REMINDED
  RECEIVED
  SUBMITTED
}

enum RiskSeverity {
  INFO
  WARNING
  CRITICAL
}

enum RequirementItemKind {
  TRANSCRIPT
  TEST_SCORES
  ACTIVITIES_LIST
  COMMON_APP_ESSAY
  SUPPLEMENT_ESSAY
  RECOMMENDATION
  COUNSELOR_LETTER
  PORTFOLIO
  INTERVIEW
  FINANCIAL_AID
  APPLICATION_FORM
  CUSTOM
}

enum RequirementItemStatus {
  PENDING
  IN_PROGRESS
  WAITING_ON_EXTERNAL
  DONE
  NOT_APPLICABLE
}

enum MeetingRequestStatus {
  AWAITING_STUDENT     // sent, waiting for response
  COUNTER_PROPOSED     // student proposed an alternative time
  CONFIRMED            // student picked a slot; Meeting created
  CANCELLED            // counselor cancelled before confirmation
  EXPIRED              // magic link expired without response
}

enum MeetingRequestSlotStatus {
  PROPOSED
  CHOSEN
  REJECTED
}

// =============================================
// USER (synced from Clerk on first login)
// =============================================

model User {
  id            String    @id // Clerk userId
  name          String
  email         String    @unique
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  timezone      String    @default("America/New_York")

  // CounselFlow relations
  students      Student[]
  meetings      Meeting[]
  assignedTasks Task[]         @relation("AssignedTasks")
  createdTasks  Task[]         @relation("CreatedTasks")
  communications Communication[]
  reviewQueue   ReviewQueueItem[]
  aiOutputs     AIOutput[]
  integrations  Integration[]
  meetingRequests MeetingRequest[]
}

// =============================================
// INTEGRATIONS (Zoom OAuth, etc.)
// =============================================

model Integration {
  id             String   @id @default(cuid())
  counselorId    String
  counselor      User     @relation(fields: [counselorId], references: [id], onDelete: Cascade)

  provider       String   // "zoom"
  providerUserId String?
  accountLabel   String?

  accessToken    String
  refreshToken   String?
  expiresAt      DateTime?
  scopes         String?

  metadata       Json?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([counselorId, provider])
  @@index([counselorId])
}

// =============================================
// STUDENT & FAMILY
// =============================================

model Student {
  id             String        @id @default(cuid())
  counselorId    String
  counselor      User          @relation(fields: [counselorId], references: [id])

  // Demographics
  firstName      String
  lastName       String
  preferredName  String?
  email          String?
  phone          String?
  dateOfBirth    DateTime?
  gradeLevel     GradeLevel
  highSchool     String?
  graduationYear Int

  // Academic snapshot
  gpaUnweighted  Float?
  gpaWeighted    Float?
  satScore       Int?
  actScore       Int?
  classRank      String?
  courseRigor     String?

  // Profile
  intendedMajors String[]
  interests      String[]
  personalNotes  String?
  rawProfile     Json?

  status         StudentStatus @default(ACTIVE)
  phase          StudentPhase  @default(EXPLORATION)

  // Relations
  guardians      Guardian[]
  applications   Application[]
  activities     Activity[]
  essayArtifacts EssayArtifact[]
  milestones     Milestone[]
  tasks          Task[]
  documents      Document[]
  meetings       Meeting[]
  communications Communication[]
  recommenders   StudentRecommender[]
  riskFlags      RiskFlag[]
  meetingRequests MeetingRequest[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([counselorId])
  @@index([counselorId, status])
  @@index([counselorId, graduationYear])
}

model Guardian {
  id               String          @id @default(cuid())
  studentId        String
  student          Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  firstName        String
  lastName         String
  relationship     String
  email            String?
  phone            String?
  preferredContact String?
  notes            String?

  communications   Communication[]
  meetingRequests  MeetingRequest[]

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

// =============================================
// SCHOOLS & APPLICATIONS
// =============================================

model School {
  id             String              @id @default(cuid())
  name           String
  commonName     String?
  city           String?
  state          String?
  country        String              @default("US")
  type           String?
  website        String?

  acceptanceRate Float?
  medianSAT      Int?
  medianACT      Int?

  requirements   SchoolRequirement[]
  applications   Application[]

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([name, city, state])
}

model SchoolRequirement {
  id                    String              @id @default(cuid())
  schoolId              String
  school                School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  applicationPlatform   ApplicationPlatform
  applicationType       ApplicationType
  deadline              DateTime?
  academicYear          String

  essaysRequired        Json?
  testPolicy            String?
  recommendationCount   Int?
  supplementalMaterials String?
  interviewPolicy       String?
  additionalNotes       String?
  sourceUrl             String?
  lastVerified          DateTime?

  applications          Application[]

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([schoolId, academicYear])
}

model Application {
  id                String             @id @default(cuid())
  studentId         String
  student           Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId          String
  school            School             @relation(fields: [schoolId], references: [id])
  requirementId     String?
  requirement       SchoolRequirement? @relation(fields: [requirementId], references: [id])

  applicationType   ApplicationType
  platform          ApplicationPlatform
  status            ApplicationStatus  @default(PLANNING)

  deadline          DateTime?
  submittedAt       DateTime?
  decisionDate      DateTime?
  decision          String?

  completionPct     Float?             @default(0)
  blockers          Json?

  essays            EssayArtifact[]
  recommenders      StudentRecommender[]
  submissionEvents  SubmissionEvent[]
  requirementItems  ApplicationRequirementItem[]

  notes             String?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([studentId])
  @@unique([studentId, schoolId, applicationType])
}

// =============================================
// ACTIVITIES & ESSAYS
// =============================================

model Activity {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  name           String
  category       String
  role           String?
  organization   String?
  description    String?
  hoursPerWeek   Float?
  weeksPerYear   Float?
  yearsActive    String?
  honors         String?
  significance   String?

  sortOrder      Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([studentId])
}

model EssayArtifact {
  id             String       @id @default(cuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  applicationId  String?
  application    Application? @relation(fields: [applicationId], references: [id])

  title          String
  prompt         String?
  wordLimit      Int?
  currentContent String?
  status         EssayStatus  @default(BRAINSTORMING)
  versionNumber  Int          @default(1)
  aiNotes        String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([studentId])
  @@index([applicationId])
}

// =============================================
// MILESTONES & TASKS
// =============================================

model Milestone {
  id             String          @id @default(cuid())
  studentId      String
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  title          String
  description    String?
  category       String

  status         MilestoneStatus @default(NOT_STARTED)

  targetDate     DateTime?
  hardDeadline   DateTime?
  completedAt    DateTime?
  sortOrder      Int             @default(0)

  dependsOnId    String?
  dependsOn      Milestone?      @relation("MilestoneDeps", fields: [dependsOnId], references: [id])
  dependedOnBy   Milestone[]     @relation("MilestoneDeps")

  templateKey    String?

  tasks          Task[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([studentId])
  @@index([studentId, status])
}

model Task {
  id             String       @id @default(cuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  milestoneId    String?
  milestone      Milestone?   @relation(fields: [milestoneId], references: [id])

  title          String
  description    String?

  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  source         TaskSource   @default(MANUAL)

  assignedToId   String?
  assignedTo     User?        @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdById    String
  createdBy      User         @relation("CreatedTasks", fields: [createdById], references: [id])

  dueDate        DateTime?
  completedAt    DateTime?

  aiOutputId     String?
  aiOutput       AIOutput?    @relation(fields: [aiOutputId], references: [id])

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([studentId])
  @@index([assignedToId, status])
  @@index([dueDate])
}

// =============================================
// RECOMMENDERS
// =============================================

model StudentRecommender {
  id               String                   @id @default(cuid())
  studentId        String
  student          Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  applicationId    String?
  application      Application?             @relation(fields: [applicationId], references: [id])

  name             String
  email            String?
  type             RecommenderType
  relationship     String?
  organization     String?

  requestStatus    RecommenderRequestStatus @default(NOT_REQUESTED)
  requestedAt      DateTime?
  reminderSentAt   DateTime?
  receivedAt       DateTime?
  submittedAt      DateTime?

  bragSheetDraft   String?
  bragSheetFinal   String?
  requestEmailDraft String?

  notes            String?

  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([studentId])
}

// =============================================
// MEETINGS
// =============================================

model Meeting {
  id             String   @id @default(cuid())
  counselorId    String
  counselor      User     @relation(fields: [counselorId], references: [id])
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  scheduledAt    DateTime
  duration       Int?
  type           String
  location       String?

  // External meeting identity (Zoom / Meet / Teams URL)
  meetingUrl         String?

  // Which system recorded this meeting
  recordingSource    String?  // "zoom" | "recall" | "manual_upload"
  externalRecordingId String? // Zoom recording id or Recall bot id

  // Recall.ai bot lifecycle
  recallBotId        String?
  recallBotStatus    String?  // "scheduled" | "in_call" | "done" | "failed"

  // Pre-meeting AI
  prepBrief      String?
  prepBriefAiId  String?

  // Post-meeting
  rawNotes       String?
  summary        String?
  summaryAiId    String?

  actionItems    Json?
  decisions      Json?

  // The MeetingRequest that gave rise to this Meeting (if any).
  // Created via the public RSVP flow, then linked here on confirmation.
  meetingRequest MeetingRequest?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([counselorId])
  @@index([studentId])
  @@index([scheduledAt])
}

// =============================================
// COMMUNICATIONS
// =============================================

model Communication {
  id             String                 @id @default(cuid())
  counselorId    String
  counselor      User                   @relation(fields: [counselorId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId     String?
  guardian       Guardian?              @relation(fields: [guardianId], references: [id], onDelete: SetNull)

  type           CommunicationType
  direction      CommunicationDirection
  subject        String?
  body           String

  isDraft        Boolean                @default(true)
  draftAiId      String?
  draftAi        AIOutput?              @relation("CommunicationDraftAI", fields: [draftAiId], references: [id], onDelete: SetNull)
  approvedAt     DateTime?
  sentAt         DateTime?

  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([studentId])
  @@index([counselorId, isDraft])
}

// =============================================
// DOCUMENTS
// =============================================

model Document {
  id             String       @id @default(cuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  fileName       String
  fileType       String       // MIME type
  fileSize       Int
  documentType   DocumentType // auto-detected by Gemini; defaults to OTHER

  storageUrl     String
  storageKey     String

  extractedText  String?
  structuredData Json?        // the raw profile extraction output from Gemini
  processedAt    DateTime?
  aiOutputId     String?

  // Extraction pipeline state: PROCESSING | READY | APPLIED | REJECTED | FAILED
  extractionStatus String?    @default("PROCESSING")
  extractionError  String?    // populated on FAILED

  notes          String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([studentId])
  @@index([studentId, documentType])
  @@index([studentId, extractionStatus])
}

// =============================================
// SUBMISSION TRACKING
// =============================================

model SubmissionEvent {
  id             String      @id @default(cuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  component      String
  submittedAt    DateTime
  confirmationId String?
  submittedBy    String?
  notes          String?

  createdAt      DateTime    @default(now())
}

// =============================================
// RISK FLAGS
// =============================================

model RiskFlag {
  id             String       @id @default(cuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  severity       RiskSeverity
  category       String
  title          String
  description    String

  resolvedAt     DateTime?
  resolvedBy     String?
  resolution     String?

  aiOutputId     String?
  aiOutput       AIOutput?    @relation(fields: [aiOutputId], references: [id])

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([studentId])
  @@index([studentId, severity])
}

// =============================================
// AI PROVENANCE
// =============================================

model AIOutput {
  id             String       @id @default(cuid())
  counselorId    String
  studentId      String?

  feature        String
  sourceBasis    Json
  confidence     AIConfidence
  autonomyMode   AutonomyMode

  input          Json?
  output         Json
  modelId        String
  tokenUsage     Json?

  reviewStatus   ReviewStatus @default(PENDING)
  reviewedAt     DateTime?
  reviewedBy     String?
  reviewNotes    String?

  // Relations
  counselor      User         @relation(fields: [counselorId], references: [id], onDelete: Cascade)
  tasks          Task[]
  riskFlags      RiskFlag[]
  communicationDrafts Communication[] @relation("CommunicationDraftAI")

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([counselorId])
  @@index([studentId, feature])
}

// =============================================
// REVIEW QUEUE
// =============================================

model ReviewQueueItem {
  id             String       @id @default(cuid())
  counselorId    String
  counselor      User         @relation(fields: [counselorId], references: [id], onDelete: Cascade)

  entityType     String
  entityId       String
  aiOutputId     String?

  title          String
  summary        String?

  status         ReviewStatus @default(PENDING)
  reviewedAt     DateTime?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([counselorId, status])
}

// =============================================
// APPLICATION REQUIREMENTS (per-application checklist)
// =============================================

model ApplicationRequirementItem {
  id             String                @id @default(cuid())
  applicationId  String
  application    Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  kind           RequirementItemKind
  label          String
  description    String?
  required       Boolean               @default(true)

  status         RequirementItemStatus @default(PENDING)

  // When this item is materialized as a specific underlying record, link it.
  // The readiness engine uses these (or a derivationKey-based lookup) to
  // auto-resolve status without manual checkboxes.
  essayId        String?
  recommenderId  String?
  documentId     String?

  // For derived items (transcript / test_scores / activities / common_app_essay),
  // this key is how the readiness engine recomputes status from related records.
  derivationKey  String?

  dueDate        DateTime?
  notes          String?
  sortOrder      Int                   @default(0)

  resolvedAt     DateTime?

  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([applicationId])
  @@index([applicationId, status])
}

// =============================================
// MEETING REQUESTS (counselor → student RSVP via magic link)
// =============================================

model MeetingRequest {
  id             String                @id @default(cuid())
  counselorId    String
  counselor      User                  @relation(fields: [counselorId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId     String?
  guardian       Guardian?             @relation(fields: [guardianId], references: [id], onDelete: SetNull)

  // Magic-link token used in the public /respond/[token] URL.
  // Indexed unique so the public RSVP route is a single key lookup.
  token          String                @unique
  expiresAt      DateTime              // links expire after N days

  // Counselor's request payload
  meetingType    String                @default("Check-in")
  durationMins  Int                    @default(30)
  message        String?               // optional note shown to student
  ccGuardian     Boolean               @default(false)
  location       String?               // "Zoom" / "Phone" / address

  status         MeetingRequestStatus  @default(AWAITING_STUDENT)

  // If student counter-proposed, store it here.
  // We don't materialize a Slot for it because it's a single time the
  // counselor must accept/reject, not part of the original menu.
  counterProposalAt   DateTime?
  counterProposalNote String?

  // Once confirmed, link to the resulting Meeting.
  meetingId      String?               @unique
  meeting        Meeting?              @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  // Lifecycle timestamps
  sentAt         DateTime              @default(now())
  respondedAt    DateTime?
  remindedAt     DateTime?
  confirmedAt    DateTime?
  cancelledAt    DateTime?

  slots          MeetingRequestSlot[]

  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([counselorId, status])
  @@index([studentId])
}

model MeetingRequestSlot {
  id        String                    @id @default(cuid())
  requestId String
  request   MeetingRequest            @relation(fields: [requestId], references: [id], onDelete: Cascade)

  startAt   DateTime
  status    MeetingRequestSlotStatus  @default(PROPOSED)
  sortOrder Int                       @default(0)

  createdAt DateTime                  @default(now())

  @@index([requestId])
}

// =============================================
// MILESTONE TEMPLATES
// =============================================

model MilestoneTemplate {
  id             String   @id @default(cuid())
  key            String   @unique
  title          String
  description    String?
  category       String

  relativeTo     String?
  offsetDays     Int?
  dependsOnKey   String?

  sortOrder      Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
