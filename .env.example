# ============================================================
# CounselFlow environment variables
# Copy this file to `.env` for local dev; set the same keys in
# Vercel's dashboard (Settings → Environment Variables) for prod.
# Never commit real values — .env is gitignored.
# ============================================================

# ---------- Database (Neon) ----------
# Prefer the POOLED connection string for serverless (Vercel).
# Neon dashboard → your project → Connection string → toggle "Pooled connection" ON.
# Example:
#   postgresql://user:pwd@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ---------- Auth (Clerk) ----------
# Get keys at https://dashboard.clerk.com → your instance → API keys.
# Dev uses pk_test_ / sk_test_. Production needs a separate Clerk instance
# (or add your Vercel domain to the dev instance's allowed origins).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ---------- AI (Gemini) ----------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------- Base URL ----------
# Local:     http://localhost:3000
# Production: https://your-project.vercel.app  (or custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Vercel Blob (uploaded documents) ----------
# Vercel auto-injects BLOB_READ_WRITE_TOKEN once you create a Blob store
# under your project (Storage → Create → Blob). You don't paste it
# manually on Vercel — just create the store, redeploy.
# For local dev, you still need to paste it here.
BLOB_READ_WRITE_TOKEN=

# ---------- Future integrations (safe to leave blank for now) ----------
# Zoom OAuth — https://marketplace.zoom.us
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Recall.ai meeting bot — https://dashboard.recall.ai
RECALL_API_KEY=
RECALL_REGION=us-west-2
# HMAC-SHA256 secret for verifying Recall webhook signatures.
# Generate with: openssl rand -hex 32
# Configure the same value in the Recall.ai dashboard webhook settings.
RECALL_WEBHOOK_SECRET=

# ---------- Rate Limiting (Upstash Redis) ----------
# Optional. Rate limiting gracefully degrades (no-op) without these.
# Create a free Redis database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
